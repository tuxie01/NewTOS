 /* ---------------- screen output of rendered text ---------------- */
 
+#ifdef XG_WIRE64
+/* The rasteriser writes an MSB-first byte stream, a 68k MFDB's bytes. NewTOS reads a
+ * form as native WORDs (little-endian): swap each word around the blit. */
+static void swap_words(const u8 *bits, s32 n)
+{
+    u8 *p = (u8 *)bits, t;
+    s32 i;
+    for (i = 0; i + 1 < n; i += 2) { t = p[i]; p[i] = p[i + 1]; p[i + 1] = t; }
+}
+#endif
