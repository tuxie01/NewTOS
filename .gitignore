# Build artifacts
/target
# Worker scratch: test clones and CARGO_TARGET_DIRs, one agent-<id>/ per
# worker run, removed by tools/hooks/agent-scratch.sh at SubagentStop (TOOL46).
/target-agents/
**/*.rs.bk
Cargo.lock.bak

# Build output
/build
*.img
*.elf
*.bin

# Editor/OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local overrides (not committed)
.cargo/config.local.toml

# External reference material (acquired per contributor; copyright)
# `references/README.md` is the only file in this tree that is committed.
# EmuTOS upstream checkout lives at references/emutos/ (separate git repo,
# never modified by NewTOS). All gitignored except this README.
/references/*
!/references/README.md

# User-program build dirs (each programs/* is its own workspace)
programs/*/target/

# Local SD-card backup (RPi firmware + game ROM) — not for the public repo
sd-card-backup-*/

# Real-HW capture photos (Pi4 desktop screenshots) — local review material,
# large binaries, not repo content.
/pictures/

# Local app/tool sources — the basis for a native NewTOS toolchain
# (compiler + tools). Kept out of the OS repo; see Task #76.
/Applications/

# Python bytecode from tools/
**/__pycache__/

# Agent worktrees (git worktrees created per subagent job; hundreds of MB and
# regenerable — the work itself lands on the branch, not here).
/.claude/worktrees/

# Measurement scratch. The EVIDENCE of a dumper run — the .BIN/.LOG dumps, the
# tosdiff output and the screendumps — IS tracked, deliberately: a measurement
# that nobody can re-read later is not evidence. What is excluded is the
# regenerable bulk around it: the per-run SD images (64 MB each; rebuild with
# tools/make-sd-image.sh plus the per-case staging) and the kernel binaries
# (rebuild with `cargo xtask build --release`; their sha256 is in the report).
measurements/*/qemu-tmp/
measurements/*/*.img
measurements/*/*.elf

# Mega-ST-style Pi 4 enclosure (STLs, build.py, version zips). Hardware for
# running NewTOS, not NewTOS — same reasoning as the ball demo: this repo is
# the operating system.
/hardware/

# Local Claude Code permissions (per machine)
.claude/settings.local.json
