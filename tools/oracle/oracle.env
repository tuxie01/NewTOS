# oracle.env -- the one place that names the EmuTOS oracle's inputs.
#
# Read by tools/oracle/*.sh, tools/hatari-*.sh (shell: `. oracle.env`) and
# tosdump/Makefile (make: `include`). Plain NAME=value lines only, no quotes,
# no spaces, no shell or make syntax beyond that, so both readers agree.
# Provenance and the measurements behind every value: docs/analysis/ORACLE.md.
#
# Paths are absolute on purpose: nothing below may come from $PATH.

# m68k cross toolchain: prefix for gcc/as/ld/size (gcc 7.5.0, MiNT 20230908).
ORACLE_CROSS_MINT=/opt/cross-mint/bin/m68k-atari-mint-

# Hatari 2.6.1 (macOS bundle).
ORACLE_HATARI=/Volumes/Daten/hatari-2.6.1_macos/Hatari.app/Contents/MacOS/Hatari
# Pinned Hatari configuration, passed with --configfile (never the user's own).
ORACLE_HATARI_CFG=/Volumes/Daten/Development/PiRusTOS/tools/oracle/hatari.cfg

# Pinned EmuTOS build, `make 512 COUNTRY=de`. ORACLE_ROM is the committed
# binary (the safeguard); tools/oracle/build-emutos.sh rebuilds it into
# references/emutos-oracle/<commit>/ with the same sha256 (the cross-check).
ORACLE_EMUTOS_COMMIT=1a7484aba1bfba23e2c0899e243b6d8177fe41df
ORACLE_EMUTOS_DATE=2026-04-14
ORACLE_ROM=/Volumes/Daten/Development/PiRusTOS/tools/oracle/etos512de-1a7484ab.img
ORACLE_ROM_SHA256=323c87bbff65096e54a8dc00b474f6924a950ebf25cc9513bd53d495a2d2750c

# Calibration build: tag VERSION_1_4 (the source of the release ROM below),
# same recipe as the pin. Kept so the calibration stays re-runnable.
ORACLE_CAL_EMUTOS_COMMIT=978e37569bff95841e42675d11fcc6799aad8483
ORACLE_CAL_EMUTOS_DATE=2025-06-07
ORACLE_CAL_ROM=/Volumes/Daten/Development/PiRusTOS/references/emutos-oracle/v1.4/etos512de.img
ORACLE_CAL_ROM_SHA256=67bc59a6e182e3399eaff479184d17017e34789cda4c814e08530874dbec34cf

# The EmuTOS 1.4 release image the EMUTOS14-* references were measured with.
ORACLE_RELEASE_ROM=/Volumes/Daten/Development/PiRusTOS/references/emutos-oracle/release-1.4/etos512de.img
ORACLE_RELEASE_ROM_SHA256=5805c0a4834f8935c427454785d32c59e796b11ad6802101052b84fb1eb7a745
