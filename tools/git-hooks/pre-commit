#!/bin/sh
#
# pre-commit -- doc-check (TOOL29), the mapping check (TOOL40) and, when
# switched on, the ticket gap check (TOOL41) on what this commit records.
#
# Installed by `cargo xtask install-hooks` (core.hooksPath = tools/git-hooks).
# Both checks read the index (GIT_INDEX_FILE if git set it), not the
# working tree, and only problems the commit introduces block; legacy ones
# (reported at HEAD too) never do (owner decisions 2026-10-30,
# TASK/SPEC03.md, and 2026-11-10, TASK/TOOL40.md).
#
# 1. `cargo xtask doc-check --staged` (tools/xtask/src/doc_check.rs,
#    "Staged"):
#   - every staged doc (CLAUDE.md, docs/**/*.md without docs/archive/ and
#     dated snapshots, TASK/*.md and *.MD, measurements/**/RUNINFO.TXT):
#     a failure on a line new since HEAD (a broken cite, an unknown ADR, an
#     unanchored line cite into NewTOS code), or on an unchanged line whose
#     cite resolves at HEAD;
#   - every other doc of that set: a cite naming a staged path (a moved
#     anchor, a shortened, renamed or deleted file, a removed ADR) that
#     resolves at HEAD and fails in the index.
# 2. `cargo xtask deps --check-mapping --staged` (tools/xtask/src/deps.rs,
#    staged_problems): every row of docs/analysis/deps/mapping.tsv against
#    the staged edges.tsv, the staged NewTOS file and `fn` it names, the
#    staged ADR line of a `design:ADR-NNN@<file>:<line>` class and the
#    staged `source:` path. A problem is new unless HEAD has the same row
#    (its columns; a row that only moved keeps its problems) with the same
#    message. Runs only when the commit stages (adds, changes, deletes,
#    renames) docs/MEMORY.md, mapping.tsv, edges.tsv, or a file the staged
#    mapping.tsv names (newtos_file, ADR file, source: path); otherwise it
#    is skipped without starting cargo.
# 3. Only with `git config newtos.ticketChecks true` (off until the owner's
#    OK, ADR-037 point 14; off, this hook behaves exactly as after TOOL40):
#    `cargo xtask status-check --staged --new-only`
#    (tools/xtask/src/tickets.rs): the ADR-037 point 13 gaps of every
#    ticket whose file or receipt the commit stages, legacy ones recorded in
#    tools/xtask/ticket-baseline.tsv excepted (the baseline only shrinks).
#    Runs only when the commit stages TASK/ or that baseline. The checks
#    that need the message run in commit-msg.
# Any failure, or a check that cannot run, rejects the commit: `git
# commit` itself exits non-zero, however the command line chains or pipes
# around it.
#
# Bypass for one commit: git commit --no-verify (git's own switch; there is
# no other). Agents cannot use it: the PreToolUse hook
# tools/hooks/no-verify-guard.sh (.claude/settings.json) blocks it.

set -u

top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1

# The pathspecs below are globs whatever the caller's environment says.
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS

# Cheap pre-filter for doc-check: no staged doc and no staged path under the
# trees the docs cite by line (NEWTOS_CODE_ROOTS in doc_check.rs), deletions
# included -> no doc-check. Exit 0 = no such path; 1 = some; anything else
# (no HEAD, ...) falls through and doc-check reports it.
git diff --cached --quiet --no-renames HEAD -- \
    CLAUDE.md docs/ TASK/ 'measurements/*RUNINFO.TXT' \
    kernel/ tos-api/ tos-types/ programs/ tools/ tosdump/ sdk/ boot/ keyboards/ 2>/dev/null
[ $? -eq 0 ] && doc=no || doc=yes

# Cheap trigger for the mapping check: the staged paths (deletions and both
# sides of a rename included) against the three fixed inputs and the files
# the staged mapping.tsv names, read once. No HEAD, ... -> it runs and
# reports it.
map_file=docs/analysis/deps/mapping.tsv
if changed=$(git diff --cached --name-only --no-renames HEAD -- 2>/dev/null); then
    git show ":$map_file" 2>/dev/null | CHANGED=$changed awk -F '\t' '
        BEGIN {
            n = split(ENVIRON["CHANGED"], c, "\n")
            for (i = 1; i <= n; i++) ch[c[i]] = 1
            if (("docs/MEMORY.md" in ch) || ("docs/analysis/deps/mapping.tsv" in ch) ||
                ("docs/analysis/deps/edges.tsv" in ch)) { hit = 1; exit }
        }
        ($3 in ch) { hit = 1; exit }
        match($5, /^design:ADR-[0-9][0-9][0-9]@/) {
            f = substr($5, RSTART + RLENGTH); sub(/:[0-9]+$/, "", f)
            if (f in ch) { hit = 1; exit }
        }
        $5 ~ /^design:source:/ { if (substr($5, 15) in ch) { hit = 1; exit } }
        END { exit hit ? 0 : 1 }'
    [ $? -eq 0 ] && map=yes || map=no
else
    map=yes
fi

# The ticket gap check (TOOL41): only when switched on, and only for a
# staged TASK/ path or baseline (both are under the doc pre-filter's trees,
# so tick=yes implies doc=yes).
tick=no
if [ "$(git config --bool --get newtos.ticketChecks 2>/dev/null)" = true ]; then
    git diff --cached --quiet --no-renames HEAD -- TASK/ tools/xtask/ticket-baseline.tsv 2>/dev/null
    [ $? -eq 0 ] || tick=yes
fi

[ "$doc" = no ] && [ "$map" = no ] && exit 0

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not in PATH; cannot run doc-check or the mapping check on the staged files." >&2
    echo "pre-commit: commit rejected (git commit --no-verify bypasses the check)." >&2
    exit 1
fi

rc=0
if [ "$doc" = yes ] && ! cargo -q xtask doc-check --staged; then
    echo "pre-commit: doc-check failed on the staged docs or on cites this commit breaks (above)." >&2
    rc=1
fi
if [ "$map" = yes ] && ! cargo -q xtask deps --check-mapping --staged; then
    echo "pre-commit: the mapping check failed on rows this commit breaks (above, $map_file)." >&2
    rc=1
fi
if [ "$tick" = yes ] && ! cargo -q xtask status-check --staged --new-only; then
    echo "pre-commit: the ticket gap check failed (above; ADR-037 point 13, TOOL41)." >&2
    rc=1
fi
if [ $rc -ne 0 ]; then
    echo "pre-commit: commit rejected. Fix and stage the fix; git commit --no-verify bypasses the check." >&2
fi
exit $rc
