+/// EmuTOS `outline()`: `dely` rows from word `row1` (the row before is the scratch row).
+fn flat_outline(w: &mut [u16; FLAT_WORDS], sform: i64, form_width: i64, dely: i64) {
+    let mut currline = sform + form_width;
+    let mut nextline = currline + form_width;
+    let mut i = dely;
+    while i > 0 {
+        let save_next = nextline;
+        let mut prev: u16 = 0;
+        let mut curr: u16 = 0;
+        let mut bottom_left: u32 = fget32(w, nextline) >> 1;
+        let mut scratch = sform;
+        let mut j = form_width;
+        while j > 0 {
+            let mut current_left = merge_byte(w, currline, curr);
+            let current_noshift = current_left.rotate_right(1);
+            let mut current_right = current_noshift.rotate_right(1);
+            let top_right0 = merge_byte(w, scratch, prev).rotate_right(1);
+            let top_left = top_right0 ^ current_left;
+            let top_noshift = (top_right0 ^ current_noshift).rotate_left(1);
+            let top_right = (top_right0 ^ current_right).rotate_left(2);
+            let mut result = top_left | top_noshift | top_right;
+            let bottom_right0 = bottom_left;
+            bottom_left ^= current_left;
+            let bottom_noshift = (bottom_right0 ^ current_noshift).rotate_left(1);
+            let bottom_right = (bottom_right0 ^ current_right).rotate_left(2);
+            result |= bottom_left | bottom_noshift | bottom_right;
+            current_left ^= current_noshift;
+            current_right ^= current_noshift;
+            current_right = current_right.rotate_left(2);
+            result |= current_left | current_right;
+            result >>= 16;
+            let cw = fget(w, currline);
+            curr = cw;
+            let out = (cw ^ result as u16) & result as u16;
+            fset(w, currline, out);
+            currline += 1;
+            prev = fget(w, scratch);
+            fset(w, scratch, curr);
+            scratch += 1;
+            let tmp = if V41_OFF == 3 && i == 1 { 0 } else { fget(w, nextline) };
+            nextline += 1;
+            bottom_left = merge_byte(w, nextline, tmp).rotate_right(1);
+            j -= 1;
+        }
+        nextline = save_next;
+        currline = nextline;
+        if i > 2 {
+            nextline += form_width;
+        }
+        i -= 1;
+    }
+}
+
+#[inline]
+fn fset(w: &mut [u16; FLAT_WORDS], i: i64, v: u16) {
+    if i >= 0 && (i as usize) < FLAT_WORDS {
+        w[i as usize] = v;
+    }
+}
