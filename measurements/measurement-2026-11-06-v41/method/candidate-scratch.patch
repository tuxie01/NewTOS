+/// [`effect_glyph`] for one-word rows; false when the glyph needs the flat buffer. Same pixels.
+#[allow(clippy::too_many_arguments)]
+#[inline]
+fn effect_fast<const N: usize, const R: usize>(
+    rows: &[Row<N>; R],
+    size: SrcSize,
+    f: &SysFont,
+    weight: i16,
+    skew: i16,
+    skewing: bool,
+    destx: i16,
+    desty: i16,
+    clip: ClipRect,
+    clipping: bool,
+    shifts: &mut [i16; R],
+    bytes: &mut [u8; MAX_ROWS * WIDE_BYTES],
+    call: &TextCall,
+) -> bool {
+    let h = (size.h.max(0) as usize).min(R);
+    let width = size.w as i32 + weight as i32;
+    let window = width + skew as i32;
+    if h == 0 || size.w <= 0 || weight < 0 || skew < 0 || window > 64 {
+        return false;
+    }
+    let bits = ((window >> 4) + 1) * 16; // the buffer row
+    if clipping
+        && (destx < clip.xmn
+            || desty < clip.ymn
+            || destx as i32 + window - 1 > clip.xmx as i32
+            || desty as i32 + h as i32 - 1 > clip.ymx as i32)
+    {
+        return false;
+    }
+    let multi = width > 16;
+    let mut mask = f.skew;
+    let turns = if multi { h - 1 } else { h } as u32;
+    let mut win = mask.rotate_left(turns % 16);
+    let mut lean = 0i32;
+    let mut slide = 0i32;
+    let wb = (window as usize).div_ceil(8);
+    let wmask = if size.w >= 64 { !0u64 } else { !(!0u64 >> size.w) };
+    for k in 0..h {
+        let row = h - 1 - k;
+        if skewing {
+            if multi {
+                if k != 0 {
+                    let carry = mask & 0x8000 != 0;
+                    mask = mask.rotate_left(1);
+                    lean += !carry as i32;
+                }
+            } else {
+                let carry = mask & 0x8000 != 0;
+                mask = mask.rotate_left(1);
+                lean += carry as i32;
+            }
+        }
+        if lean + width > bits || slide + window > bits.min(64) || slide > 15 {
+            return false;
+        }
+        let mut b = rows[row][0] & wmask;
+        if weight > 0 {
+            let orig = b;
+            for n in 1..=(weight as u32).min(63) {
+                b |= orig >> n;
+            }
+        }
+        let v = ((b >> lean) << slide).to_be_bytes();
+        bytes[row * wb..(row + 1) * wb].copy_from_slice(&v[..wb]);
+        shifts[row] = slide as i16;
+        if skew != 0 {
+            win = win.rotate_left(1);
+            slide += (win >> 15) as i32;
+        }
+    }
+    let vwk = call.vwk;
+    let mode = WriteMode::from_wrt_mode(vwk.wrt_mode);
+    call.backend.draw_glyph_rows(destx, desty, &bytes[..h * wb], window as i16, h as i16, &shifts[..h], vwk.text_color, mode);
+    true
+}
