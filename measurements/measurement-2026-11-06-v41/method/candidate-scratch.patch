+// ---- V41 candidate (scratch, not product) ------------------------------------
+
+#[inline]
+fn fget(w: &[u16; FLAT_WORDS], i: i64) -> u16 {
+    if i >= 0 && (i as usize) < FLAT_WORDS { w[i as usize] } else { 0 }
+}
+
+/// `*(ULONG *)p`
+#[inline]
+fn fget32(w: &[u16; FLAT_WORDS], i: i64) -> u32 {
+    ((fget(w, i) as u32) << 16) | fget(w, i + 1) as u32
+}
+
+/// EmuTOS `merge_byte`.
+#[inline]
+fn merge_byte(w: &[u16; FLAT_WORDS], i: i64, n: u16) -> u32 {
+    (fget32(w, i) & 0xFFFF_FF00) | (n as u32 & 0xFF)
+}
+
+/// Replace `n` bits at bit address `pos` by the leftmost bits of `src` (word-wise replace with masks,
+/// the buffer is flat, a row past its stride lands in the next one).
+fn flat_put(w: &mut [u16; FLAT_WORDS], pos: i64, src: &[u64], n: usize) {
+    if pos < 0 {
+        return;
+    }
+    let mut p = pos as usize;
+    let mut left = n;
+    let mut si = 0;
+    while left > 0 && si < src.len() {
+        let take = left.min(64);
+        let val = src[si];
+        let mut done = 0usize;
+        while done < take {
+            let idx = p >> 4;
+            if idx >= FLAT_WORDS {
+                return;
+            }
+            let off = p & 15;
+            let cnt = (16 - off).min(take - done);
+            let top = ((val << done) >> 48) as u16; // the next 16 source bits
+            let m = ((0xFFFFu32 << (16 - cnt)) as u16) >> off;
+            w[idx] = (w[idx] & !m) | ((top >> off) & m);
+            done += cnt;
+            p += cnt;
+        }
+        left -= take;
+        si += 1;
+    }
+}
+
+/// 64 bits at bit address `pos`, leftmost at bit 63.
+#[inline]
+fn flat_u64(w: &[u16; FLAT_WORDS], pos: i64) -> u64 {
+    let i = pos >> 4;
+    let off = (pos & 15) as u32;
+    let v = ((fget(w, i) as u64) << 48) | ((fget(w, i + 1) as u64) << 32) | ((fget(w, i + 2) as u64) << 16) | fget(w, i + 3) as u64;
+    if off == 0 { v } else { (v << off) | ((fget(w, i + 4) as u64) >> (16 - off)) }
+}
+
+/// `wb` bytes at bit address `pos` into `out`.
+#[inline]
+fn flat_bytes(w: &[u16; FLAT_WORDS], pos: i64, out: &mut [u8]) {
+    let mut p = pos;
+    for c in out.chunks_mut(8) {
+        let v = flat_u64(w, p).to_be_bytes();
+        c.copy_from_slice(&v[..c.len()]);
+        p += 64;
+    }
+}
+
+#[inline]
+fn flat_bit(w: &[u16; FLAT_WORDS], pos: i64) -> bool {
+    fget(w, pos >> 4) & (0x8000u16 >> (pos & 15)) != 0
+}
