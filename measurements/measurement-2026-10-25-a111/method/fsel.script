# fsel.script -- objc_edit caret in the AES file selector (QED "Datei > Oeffnen...", fsel.rs modal loop), regression.
# Armed on up:QED (#Z autorun); 200 Hz ticks; geometry from screendumps qgeo-fsel (640x480).
# Open: park bottom-left, right to x=82, up to "Datei" (82,7), down to "Oeffnen..." (82,43), click.
200 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F 0xF8 0x80 0x7F
210 0xF8 0x52 0x00
220 0xF8 0x00 0x8A 0xF8 0x00 0x8A 0xF8 0x00 0x8A 0xF8 0x00 0x8A
400 0xF8 0x00 0x24
500 0xFA 0x00 0x00
510 0xF8 0x00 0x00
800 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F
# f1: fsel up, caret in "Selection"
1100 0xF8 0x00 0x00
# f2: type A
1400 0x1E 0x9E
# f3: click the file QED.NAP (240,222) -> selection text changes, caret to its end; pointer parked bottom-right
1700 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x7F 0x7F 0xF8 0x71 0x5F
1710 0xFA 0x00 0x00
1720 0xF8 0x00 0x00
1730 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F
# f4: click into the (already focused) Selection field (300,158)
2100 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x7F 0x7F 0xF8 0x2E 0x1F
2110 0xFA 0x00 0x00
2120 0xF8 0x00 0x00
2130 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F
# f5: Tab -> Directory field
2500 0x0F 0x8F
# f6: click into Selection again (focus change by click)
2900 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x80 0x80 0xF8 0x7F 0x7F 0xF8 0x2E 0x1F
2910 0xFA 0x00 0x00
2920 0xF8 0x00 0x00
2930 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F 0xF8 0x7F 0x7F
# f7: Left
3300 0x4B 0xCB
3700 0xF8 0x00 0x00
