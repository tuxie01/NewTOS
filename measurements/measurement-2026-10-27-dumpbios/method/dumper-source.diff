diff --git a/tosdump/core/dumpbios.c b/tosdump/core/dumpbios.c
new file mode 100644
index 00000000..213450b2
--- /dev/null
+++ b/tosdump/core/dumpbios.c
@@ -0,0 +1,113 @@
+/*
+ * dumpbios.c -- DUMPBIOS, the BIOS + XBIOS reference dumper (spec section 7,
+ * task T7).
+ *
+ * Portable.  The same source builds for TOS on the TT (or the oracle) and for
+ * NewTOS on the Pi 4; only the ABI backend underneath differs.
+ *
+ * usage: DUMPBIOS [CASES.TSV [OUT.BIN [OUT.LOG]]]
+ *        defaults: BIOS.TSV in the current directory, BIOS.BIN and BIOS.LOG
+ *        beside it.
+ *
+ * One table, one dump: trap #13 and trap #14 cases live in the same table
+ * and the same BIOS.BIN (header area TD_AREA_BIOS); each record names its
+ * trap (docs/TOS-REFERENCE-DUMPER.md section 3).
+ *
+ * Unlike DUMPVDI and DUMPAES this program is no AES client: nothing it
+ * measures needs an application context, and every GEM call it made would
+ * be one more thing that could differ between the two machines for reasons
+ * that have nothing to do with the BIOS.
+ *
+ * As in the other dumpers: the case table is read at runtime, records are
+ * buffered in RAM and written once at the end (spec section 7), the log is
+ * written once before the first case -- so a run that hangs leaves its setup
+ * and the line "running N cases" on disk -- and once at the end, and the
+ * program never waits for a key.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "cases.h"
+#include "dump.h"
+#include "log.h"
+#include "runner_call.h"
+
+#ifndef TD_BUILD_ID
+#define TD_BUILD_ID "----"
+#endif
+
+static struct td_call_case_table table;
+static uint8_t records[(size_t)TD_MAX_CASES * TD_CALL_RECORD_SIZE];
+
+static const char *log_path = "BIOS.LOG";
+
+static int finish(int rc)
+{
+	int lr = td_log_write(log_path);
+
+	if (lr != 0)
+		printf("cannot write %s (%d)\n", log_path, lr);
+	else
+		printf("%s: %lu bytes%s\n", log_path,
+		       (unsigned long)td_log_len(),
+		       td_log_truncated() ? " (truncated)" : "");
+	return rc;
+}
+
+int main(int argc, char **argv)
+{
+	const char *table_path = (argc > 1) ? argv[1] : "BIOS.TSV";
+	const char *out_path   = (argc > 2) ? argv[2] : "BIOS.BIN";
+	struct td_case_error err;
+	size_t bytes;
+	int rc;
+
+	if (argc > 3)
+		log_path = argv[3];
+
+	td_log_init();
+	td_log("DUMPBIOS build %s, record format %d\n", TD_BUILD_ID,
+	       TD_FORMAT_VERSION);
+	td_log("pointer %u bytes, word order %u\n",
+	       (unsigned)td_native_ptr_width(), (unsigned)td_native_word_order());
+
+	memset(&err, 0, sizeof err);
+	rc = td_call_cases_load(&table, TD_AREA_BIOS, table_path, &err);
+	if (rc != 0) {
+		if (err.line)
+			td_log("%s line %u: %s (%s)\n", table_path, err.line,
+			       err.what ? err.what : "", td_case_error_text(rc));
+		else
+			td_log("%s: %s (%s)\n", table_path, err.what ? err.what : "",
+			       td_case_error_text(rc));
+		return finish(1);
+	}
+	td_log("%s: %u cases, CRC %08lX\n", table_path, table.count,
+	       (unsigned long)table.crc);
+	if (table.count == 0) {
+		td_log("nothing to do\n");
+		return finish(1);
+	}
+
+	/* Written before the first case: a run that hangs still leaves this. */
+	td_log("running %u cases\n", table.count);
+	td_log_write(log_path);
+
+	bytes = (size_t)table.count * TD_CALL_RECORD_SIZE;
+	rc = td_run_call(&table, records, sizeof records);
+	if (rc != 0) {
+		td_log("runner failed (%d)\n", rc);
+		return finish(1);
+	}
+	td_log("all %u cases ran\n", table.count);
+
+	rc = td_dump_write(out_path, TD_AREA_BIOS, table.count, TD_BUILD_ID,
+	                   table.crc, records, bytes);
+	if (rc != 0) {
+		td_log("cannot write %s (%d)\n", out_path, rc);
+		return finish(1);
+	}
+	td_log("%s: %u records, %lu bytes\n", out_path, table.count,
+	       (unsigned long)(TD_HEADER_SIZE + bytes));
+	return finish(0);
+}
diff --git a/tosdump/core/runner_call.c b/tosdump/core/runner_call.c
new file mode 100644
index 00000000..201c7c4c
--- /dev/null
+++ b/tosdump/core/runner_call.c
@@ -0,0 +1,146 @@
+/*
+ * runner_call.c -- poison, call, record for the call tables.  See
+ * runner_call.h and docs/TOS-REFERENCE-DUMPER.md sections 3, 4 and 6.
+ *
+ * Portable: the same lines run on the TT and on the Pi.  The one thing that
+ * differs between the two machines -- how an argument travels -- is the ABI
+ * backend's (td_abi_trap); this file only says WHAT is passed.
+ */
+#include <string.h>
+
+#include "abi.h"
+#include "runner_call.h"
+
+/* The buffers a case names with "b:<n>".  uint32_t so that a LONG capture
+ * reads aligned on both machines. */
+static uint32_t call_buf[TD_CALL_BUF_N][TD_CALL_BUF_BYTES / 4];
+
+static struct td_call_frame run_frame;
+
+void *td_call_buffer(int n)
+{
+	if (n < 0 || n >= TD_CALL_BUF_N)
+		return NULL;
+	return call_buf[n];
+}
+
+/*
+ * Spec section 4: the 0xDEAD pattern -- laid in the UNIT the case's capture
+ * reads the buffer in.  The two machines differ in byte order, so one fill
+ * cannot read the same in every unit: the bytes DE AD are the WORD 0xADDE
+ * on AArch64, and the WORD 0xDEAD is the bytes AD DE there.  An element the
+ * call left alone must read the same on both, or the poison itself becomes
+ * a difference:
+ *
+ *   unit B (and every buffer no capture reads): the bytes DE AD, the same
+ *          memory on both -- which is also what a call that reads the
+ *          buffer as bytes (Protobt's checksum, a disk format) must see;
+ *   unit W: native WORDs 0xDEAD;   unit L: native LONGs 0xDEADDEAD.
+ */
+static void poison_buffer(int n, uint8_t unit)
+{
+	uint8_t *b = (uint8_t *)call_buf[n];
+	uint32_t *l = call_buf[n];
+	uint16_t *w = (uint16_t *)call_buf[n];
+	int i;
+
+	if (unit == 4) {
+		for (i = 0; i < TD_CALL_BUF_BYTES / 4; i++)
+			l[i] = 0xDEADDEADuL;
+	} else if (unit == 2) {
+		for (i = 0; i < TD_CALL_BUF_BYTES / 2; i++)
+			w[i] = (uint16_t)TD_POISON16;
+	} else {
+		for (i = 0; i < TD_CALL_BUF_BYTES; i += 2) {
+			b[i]     = TD_POISON_HI;
+			b[i + 1] = TD_POISON_LO;
+		}
+	}
+}
+
+static void poison_buffers(const struct td_call_case *c)
+{
+	int n;
+
+	for (n = 0; n < TD_CALL_BUF_N; n++) {
+		uint8_t unit = 1;
+
+		if (c->cap_arg >= 0 && c->arg[c->cap_arg].value == n)
+			unit = c->cap_unit;
+		poison_buffer(n, unit);
+	}
+}
+
+int td_run_call(const struct td_call_case_table *ct, uint8_t *out,
+                size_t out_bytes)
+{
+	uint8_t kind[TD_ABI_ARGS_MAX];
+	long value[TD_ABI_ARGS_MAX];
+	uint16_t i;
+	int j;
+
+	if (out_bytes < (size_t)ct->count * TD_CALL_RECORD_SIZE)
+		return TD_RUN_CALL_ERR_BUFFER;
+
+	for (i = 0; i < ct->count; i++) {
+		const struct td_call_case *c = &ct->cases[i];
+		uint8_t *rec = out + (size_t)i * TD_CALL_RECORD_SIZE;
+		int64_t r;
+		long ret;
+
+		/* 1. poison the frame and both buffers (spec section 4) */
+		td_poison_call(&run_frame);
+		poison_buffers(c);
+
+		/* 2. the arguments: what the backend passes, and what the record
+		 *    says was passed.  An unused register slot carries poison. */
+		for (j = 0; j < TD_ABI_ARGS_MAX; j++) {
+			kind[j]  = 0;
+			value[j] = (long)(int32_t)0xDEADDEADuL;
+		}
+		for (j = 0; j < (int)c->nargs; j++) {
+			const struct td_call_arg *a = &c->arg[j];
+
+			switch (a->kind) {
+			case TD_CALL_ARG_WORD:
+				kind[j]  = TD_ABI_ARG_WORD;
+				value[j] = (long)(int16_t)a->value;
+				run_frame.args[j] = (uint32_t)(int32_t)(int16_t)a->value;
+				break;
+			case TD_CALL_ARG_LONG:
+				kind[j]  = TD_ABI_ARG_LONG;
+				value[j] = (long)a->value;
+				run_frame.args[j] = (uint32_t)a->value;
+				break;
+			default:   /* TD_CALL_ARG_BUF: its address, and its token */
+				kind[j]  = TD_ABI_ARG_LONG;
+				value[j] = (long)td_call_buffer((int)a->value);
+				run_frame.args[j] = TD_CALL_BUF_TOKEN(a->value);
+				break;
+			}
+		}
+		run_frame.trap = c->trap;
+
+		/* 3. the call under measurement */
+		ret = td_abi_trap(c->trap, c->opcode, c->nargs, kind, value);
+
+		/* 4. the return register at its native width, as one 64-bit
+		 *    value: on the m68k the high half is the sign extension of
+		 *    d0, on AArch64 it is x0's own (section 3) */
+		r = (int64_t)ret;
+		run_frame.ret    = (int32_t)(uint32_t)((uint64_t)r & 0xFFFFFFFFuL);
+		run_frame.ret_hi = (uint32_t)((uint64_t)r >> 32);
+
+		/* 5. the capture, element by element in record order */
+		if (c->cap_arg >= 0) {
+			const uint8_t *b =
+				(const uint8_t *)td_call_buffer((int)c->arg[c->cap_arg].value);
+
+			td_call_capture(run_frame.capture, b + c->cap_off, c->cap_len,
+			                c->cap_unit);
+		}
+
+		td_call_record_write(rec, c->line, (uint16_t)c->opcode, &run_frame);
+	}
+	return 0;
+}
diff --git a/tosdump/core/runner_call.h b/tosdump/core/runner_call.h
new file mode 100644
index 00000000..775c4792
--- /dev/null
+++ b/tosdump/core/runner_call.h
@@ -0,0 +1,27 @@
+/*
+ * runner_call.h -- poison, call, record for the call tables (BIOS + XBIOS).
+ *
+ * Spec: docs/TOS-REFERENCE-DUMPER.md sections 3, 4 and 6 ("The call table,
+ * as built for DUMPBIOS").
+ *
+ * One case is: poison the frame and both buffers, marshal the arguments
+ * (a buffer argument becomes the buffer's address, and its TOKEN in the
+ * record), issue the trap through the ABI backend, copy the capture, write
+ * the record.  No reset: a round-1 call table holds queries only.
+ */
+#ifndef TOSDUMP_RUNNER_CALL_H
+#define TOSDUMP_RUNNER_CALL_H
+
+#include "cases.h"
+
+#define TD_RUN_CALL_ERR_BUFFER (-1)   /* the output cannot hold every record */
+
+int td_run_call(const struct td_call_case_table *ct, uint8_t *out,
+                size_t out_bytes);
+
+/* The runner's own buffer n (0..TD_CALL_BUF_N-1), for the host tests'
+ * stub backend, which has to recognise a buffer address to write into it
+ * the way a real call would. */
+void *td_call_buffer(int n);
+
+#endif /* TOSDUMP_RUNNER_CALL_H */
diff --git a/tosdump/build-dumpbios-newtos.sh b/tosdump/build-dumpbios-newtos.sh
new file mode 100755
index 00000000..c98302c0
--- /dev/null
+++ b/tosdump/build-dumpbios-newtos.sh
@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+#
+# build-dumpbios-newtos.sh -- build DUMPBIOS.NAP, the NewTOS/AArch64 half of the
+# TOS reference dumper (docs/TOS-REFERENCE-DUMPER.md, task T4).
+#
+# Same portable core as the TT build (core/*.c), same case table, only
+# abi/newtos_svc.c instead of abi/m68k_trap.c. It follows the proven client
+# link path of the other NewTOS apps (sdk/apps/build-qed.sh): clang
+# -target aarch64-unknown-none-elf, the libc-aware crt0, mintlib's libc.a, and
+# sdk/newtos.ld. No gemlib: the dumper issues the BIOS and XBIOS traps itself
+# through its own thin backend, so no library sits between the measurement
+# and the kernel.
+#
+# A .NAP like the other dumpers, so the desktop's #Z autorun starts it the
+# same way; unlike them it makes no AES or VDI call (core/dumpbios.c).
+#
+# Usage:  tosdump/build-dumpbios-newtos.sh [output.NAP]
+set -uo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"        # .../tosdump
+ROOT="$(cd "$HERE/.." && pwd)"
+SDK="$ROOT/sdk"
+LIBC="$SDK/libc"
+BUILD="$HERE/build"
+OBJ="$BUILD/obj-newtos-bios"
+OUT="${1:-$BUILD/DUMPBIOS.NAP}"
+mkdir -p "$OBJ"
+
+# --- libc ---------------------------------------------------------------------
+if [ ! -f "$LIBC/libc.a" ]; then
+  echo "libc.a absent -- running build-libc.sh first…"
+  "$LIBC/build-libc.sh" >/dev/null 2>&1 || { echo "error: build-libc.sh failed" >&2; exit 1; }
+fi
+MINT="$LIBC/mintlib/include"
+[ -d "$MINT" ] || { echo "error: mintlib headers missing ($MINT); run build-libc.sh" >&2; exit 1; }
+
+# --- toolchain ----------------------------------------------------------------
+CLANG="${CLANG:-clang}"
+command -v "$CLANG" >/dev/null 2>&1 || { echo "error: clang not found" >&2; exit 1; }
+RES="$($CLANG -print-resource-dir)/include"
+SYSROOT="$(rustc --print sysroot 2>/dev/null)"
+BIN="$SYSROOT/lib/rustlib/$(rustc -vV | sed -n 's/host: //p')/bin"
+LLD="${LLD:-$BIN/rust-lld}"
+READOBJ="$BIN/llvm-readobj"
+NM="$BIN/llvm-nm"
+[ -x "$LLD" ] || { echo "error: missing rust-lld ($LLD)" >&2; exit 1; }
+
+# The header's build id field is exactly 4 bytes; git widens --short when 4
+# hex digits are not unique, so cut it to what actually gets stored.
+BUILD_ID="$(cd "$ROOT" && git rev-parse HEAD 2>/dev/null | cut -c1-4)"
+[ -n "$BUILD_ID" ] || BUILD_ID='----'
+
+# AArch64 is little-endian, so the record writer swaps on write. This is the
+# only compile-time difference from the TT build (spec section 2.1).
+CFLAGS=(-target aarch64-unknown-none-elf -ffreestanding -nostdlib -O2
+        -fPIE -fno-builtin -nostdinc -D__NEWTOS__
+        -std=c99 -Wall -Wextra -Werror
+        -DTD_BIG_ENDIAN_TARGET=0 -DTD_BUILD_ID="\"$BUILD_ID\"")
+INCS=(-I"$HERE/core" -I"$MINT" -isystem "$RES")
+
+echo "clang : $($CLANG --version | head -1)"
+echo "lld   : $LLD"
+echo "build : $BUILD_ID"
+echo
+
+SRC=(core/record.c core/cases.c core/dump.c core/log.c core/runner_call.c
+     core/dumpbios.c abi/newtos_svc.c)
+
+rm -f "$OBJ"/*.o
+for s in "${SRC[@]}"; do
+    o="$OBJ/$(echo "${s%.c}" | tr '/' '__').o"
+    if ! "$CLANG" "${CFLAGS[@]}" "${INCS[@]}" -c "$HERE/$s" -o "$o"; then
+        echo "error: $s failed to compile" >&2
+        exit 1
+    fi
+    echo "  CC  $s"
+done
+
+"$CLANG" -target aarch64-unknown-none-elf -ffreestanding -nostdlib -O2 \
+    -fPIE -fno-builtin -nostdinc -I"$SDK/include" -I"$MINT" -isystem "$RES" \
+    -c "$LIBC/crt0.S" -o "$BUILD/crt0-newtos-bios.o" || exit 1
+
+rm -f "$OUT"
+"$LLD" -flavor gnu -T "$SDK/newtos.ld" -pie --no-dynamic-linker -z text -z max-page-size=0x1000 \
+    --build-id=none --why-extract="$BUILD/why-newtos-bios.txt" \
+    "$BUILD/crt0-newtos-bios.o" "$OBJ"/*.o "$LIBC/libc.a" \
+    -o "$OUT" 2>"$BUILD/link-newtos-bios.err"
+lr=$?
+
+if [ $lr -ne 0 ]; then
+    echo
+    echo "LINK FAILED -- residual undefined symbols:"
+    grep -oE "undefined symbol: [^ ]+" "$BUILD/link-newtos-bios.err" \
+        | awk '{print $3}' | sort -u | sed 's/^/    /'
+    exit 1
+fi
+
+echo
+echo "LINK OK -> $OUT ($(wc -c < "$OUT" | tr -d ' ') bytes)"
+"$READOBJ" --file-headers "$OUT" | grep -iE 'Class:|DataEncoding:|Type:|Machine:|Entry:'
+u=$("$NM" -u "$OUT" 2>/dev/null | grep -c . || true)
+echo "undefined symbols in the final image (goal 0): $u"
+[ "$u" -eq 0 ] || exit 1
