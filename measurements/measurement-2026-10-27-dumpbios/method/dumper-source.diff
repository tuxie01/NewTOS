diff --git a/tosdump/abi/m68k_trap.c b/tosdump/abi/m68k_trap.c
index 40df6c45..a98daa9d 100644
--- a/tosdump/abi/m68k_trap.c
+++ b/tosdump/abi/m68k_trap.c
@@ -92,3 +92,65 @@ int32_t td_abi_aes(int16_t *control, int16_t *global, int16_t *int_in,
 	);
 	return (int32_t)ret;
 }
+
+/*
+ * The register / stack traps (abi.h): GEMDOS trap #1, BIOS trap #13, XBIOS
+ * trap #14.  The frame is what mintlib's trap_13_wwl & friends push
+ * (sdk/libc/mintlib/include/mint/osbind.h, the m68k original): the
+ * arguments right to left, a WORD as one WORD and a LONG as two, most
+ * significant first, then the function number on top.  It is laid here in
+ * a WORD array in exactly that memory order and copied onto the stack in
+ * one loop, so the frame does not depend on how many arguments a case has.
+ *
+ * Every operand the asm still needs after it has moved the stack pointer is
+ * in a register ("a"/"d"), never a stack-relative memory operand, and none
+ * of them is in d0-d2/a0-a2, which the trap may clobber and which the asm
+ * uses itself -- the clobber list keeps the compiler out of them.  The
+ * trap returns with d3-d7/a3-a6 intact (bios/vectors.S, biosxbios saves
+ * them), so the frame size survives it.
+ */
+#define TD_M68K_FRAME_WORDS (1 + 2 * TD_ABI_ARGS_MAX)
+
+#define TD_M68K_TRAP(insn)                                                  \
+	__asm__ volatile (                                                      \
+		"move.l %1,%%a0\n\t"      /* a0 = end of the frame          */      \
+		"move.l %2,%%d1\n\t"      /* d1 = WORDs - 1, for dbra       */      \
+		"1:\n\t"                                                            \
+		"move.w -(%%a0),-(%%sp)\n\t"                                        \
+		"dbra   %%d1,1b\n\t"                                                \
+		insn "\n\t"                                                         \
+		"add.l  %3,%%sp\n\t"      /* pop the frame                  */      \
+		"move.l %%d0,%0"                                                    \
+		: "=&d"(ret)                                                        \
+		: "a"(end), "d"(count), "d"(bytes)                                  \
+		: "d0", "d1", "d2", "a0", "a1", "a2", "memory", "cc")
+
+long td_abi_trap(int16_t trap, int16_t opcode, uint16_t nargs,
+                 const uint8_t *kind, const long *value)
+{
+	uint16_t frame[TD_M68K_FRAME_WORDS];
+	uint16_t *end;
+	long ret = TD_ABI_NO_TRAP, count, bytes;
+	int n = 0, i;
+
+	frame[n++] = (uint16_t)opcode;
+	for (i = 0; i < (int)nargs && i < TD_ABI_ARGS_MAX; i++) {
+		if (kind[i] == TD_ABI_ARG_WORD) {
+			frame[n++] = (uint16_t)value[i];
+		} else {
+			frame[n++] = (uint16_t)((unsigned long)value[i] >> 16);
+			frame[n++] = (uint16_t)value[i];
+		}
+	}
+	end   = frame + n;
+	count = n - 1;
+	bytes = 2L * n;
+
+	switch (trap) {
+	case 1:  TD_M68K_TRAP("trap   #1");  break;
+	case 13: TD_M68K_TRAP("trap   #13"); break;
+	case 14: TD_M68K_TRAP("trap   #14"); break;
+	default: break;
+	}
+	return ret;
+}
diff --git a/tosdump/abi/newtos_svc.c b/tosdump/abi/newtos_svc.c
index d0797c99..812cba40 100644
--- a/tosdump/abi/newtos_svc.c
+++ b/tosdump/abi/newtos_svc.c
@@ -96,3 +96,46 @@ int32_t td_abi_aes(int16_t *control, int16_t *global, int16_t *int_in,
 	);
 	return (int32_t)x0;
 }
+
+/*
+ * The register traps (abi.h): GEMDOS svc #1, BIOS svc #13, XBIOS svc #14.
+ * The register ABI is the one sdk/libc/mintlib/include/mint/osbind.h's
+ * NewTOS trap layer uses (verified there against tos_api::trap): the
+ * function number in x8, the arguments in x0..x7 left to right, the result
+ * in x0; the SVC entry preserves x1..x29.  `value` already holds every
+ * argument at register width -- a WORD sign-narrowed, a LONG sign-extended,
+ * a pointer whole, an unused slot poison -- so all eight registers are
+ * loaded as they stand.  `kind` says how a WORD travels on the m68k stack;
+ * a register has one width, so it has nothing to say here.
+ */
+#define TD_SVC_TRAP(insn)                                                   \
+	__asm__ __volatile__ (                                                  \
+		insn                                                                \
+		: "+r"(x0)                                                          \
+		: "r"(x1), "r"(x2), "r"(x3), "r"(x4), "r"(x5), "r"(x6), "r"(x7),     \
+		  "r"(x8)                                                           \
+		: "memory", "cc")
+
+long td_abi_trap(int16_t trap, int16_t opcode, uint16_t nargs,
+                 const uint8_t *kind, const long *value)
+{
+	register long x0 __asm__("x0") = value[0];
+	register long x1 __asm__("x1") = value[1];
+	register long x2 __asm__("x2") = value[2];
+	register long x3 __asm__("x3") = value[3];
+	register long x4 __asm__("x4") = value[4];
+	register long x5 __asm__("x5") = value[5];
+	register long x6 __asm__("x6") = value[6];
+	register long x7 __asm__("x7") = value[7];
+	register long x8 __asm__("x8") = (long)opcode;
+
+	(void)nargs;
+	(void)kind;
+	switch (trap) {
+	case 1:  TD_SVC_TRAP("svc	#1");  break;
+	case 13: TD_SVC_TRAP("svc	#13"); break;
+	case 14: TD_SVC_TRAP("svc	#14"); break;
+	default: return TD_ABI_NO_TRAP;
+	}
+	return x0;
+}
diff --git a/tosdump/core/abi.h b/tosdump/core/abi.h
index d4251177..3df51a58 100644
--- a/tosdump/core/abi.h
+++ b/tosdump/core/abi.h
@@ -36,4 +36,36 @@ int32_t td_abi_vdi(int16_t *contrl, int16_t *intin, int16_t *ptsin,
 int32_t td_abi_aes(int16_t *control, int16_t *global, int16_t *int_in,
                    int16_t *int_out, void **addr_in, void **addr_out);
 
+/*
+ * The register / stack traps: GEMDOS (1), BIOS (13), XBIOS (14).
+ *
+ * `kind[i]` says how argument i travels -- the one thing the two ABIs
+ * disagree about:
+ *
+ *   TD_ABI_ARG_WORD  one WORD on the m68k stack (the low 16 bits of
+ *                    value[i]); on AArch64 the register gets value[i],
+ *                    which the caller has already sign-narrowed.
+ *   TD_ABI_ARG_LONG  a LONG or a pointer: two WORDs on the m68k stack, most
+ *                    significant first; on AArch64 the whole register.
+ *
+ * `value` always holds TD_ABI_ARGS_MAX entries.  The m68k backend pushes
+ * the first `nargs` right to left under the function number, issues the
+ * trap and pops the frame; the AArch64 backend loads all eight into x0..x7
+ * (the caller fills the unused ones with poison) and the function number
+ * into x8, as sdk/libc/mintlib/include/mint/osbind.h's NewTOS trap layer
+ * does.  Marshalling only, no logic (spec section 2, section 8 rule 5).
+ *
+ * Returns the return register at its native width -- d0 (32 bits) on the
+ * m68k, x0 (64 bits) on AArch64 -- as a `long`, which is exactly that width
+ * on both.  An unknown trap number issues nothing and returns
+ * TD_ABI_NO_TRAP; the case loader never lets one through.
+ */
+#define TD_ABI_ARG_WORD  1
+#define TD_ABI_ARG_LONG  2
+#define TD_ABI_ARGS_MAX  8
+#define TD_ABI_NO_TRAP   ((long)(int32_t)0xDEADDEADuL)
+
+long td_abi_trap(int16_t trap, int16_t opcode, uint16_t nargs,
+                 const uint8_t *kind, const long *value);
+
 #endif /* TOSDUMP_ABI_H */
diff --git a/tosdump/core/cases.c b/tosdump/core/cases.c
index 3f12140a..fbe4f0e7 100644
--- a/tosdump/core/cases.c
+++ b/tosdump/core/cases.c
@@ -2674,6 +2674,704 @@ int td_rast_cases_load(struct td_rast_case_table *t, const char *path,
 	return rc;
 }
 
+/* ------------------------------------------------------------------ */
+/* Call tables: BIOS + XBIOS (cases.h, "Call tables")                  */
+/* ------------------------------------------------------------------ */
+
+/*
+ * One 32-bit value, decimal or 0x hex, -2147483648..4294967295: a LONG is
+ * stated as a bit pattern (0xFFFFFFFF) as often as a number (-1), and both
+ * spellings must reach the machine as the same 32 bits.
+ */
+static int parse_value32(const char *s, size_t len, int32_t *out)
+{
+	int negative = 0, base = 10, digits = 0;
+	uint32_t v = 0;
+	size_t i = 0;
+
+	trim(&s, &len);
+	if (len == 0)
+		return TD_CASE_ERR_VALUE;
+	if (s[0] == '-') {
+		negative = 1;
+		i = 1;
+	} else if (s[0] == '+') {
+		i = 1;
+	}
+	if (len - i > 2 && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
+		base = 16;
+		i += 2;
+	}
+	for (; i < len; i++) {
+		uint32_t d;
+		char c = s[i];
+
+		if (c >= '0' && c <= '9')
+			d = (uint32_t)(c - '0');
+		else if (base == 16 && c >= 'a' && c <= 'f')
+			d = (uint32_t)(c - 'a' + 10);
+		else if (base == 16 && c >= 'A' && c <= 'F')
+			d = (uint32_t)(c - 'A' + 10);
+		else
+			return TD_CASE_ERR_VALUE;
+		if (v > (0xFFFFFFFFuL - d) / (uint32_t)base)
+			return TD_CASE_ERR_RANGE;
+		v = v * (uint32_t)base + d;
+		digits++;
+	}
+	if (digits == 0)
+		return TD_CASE_ERR_VALUE;
+	if (negative) {
+		if (v > 0x80000000uL)
+			return TD_CASE_ERR_RANGE;
+		*out = (int32_t)(0u - v);
+	} else {
+		*out = (int32_t)v;
+	}
+	return 0;
+}
+
+/* A small unsigned number, for the trap, the function and the capture. */
+static int parse_small(const char *s, size_t len, uint32_t max, uint32_t *out)
+{
+	int32_t v;
+	int rc = parse_value32(s, len, &v);
+
+	if (rc != 0)
+		return rc;
+	if (v < 0 || (uint32_t)v > max)
+		return TD_CASE_ERR_RANGE;
+	*out = (uint32_t)v;
+	return 0;
+}
+
+const char *td_retclass_name(uint8_t retclass)
+{
+	switch (retclass) {
+	case TD_RET_EXACT:   return "EXACT";
+	case TD_RET_IGNORE:  return "IGNORE";
+	case TD_RET_NONZERO: return "NONZERO";
+	case TD_RET_HANDLE:  return "HANDLE";
+	case TD_RET_PTR_RAM: return "PTR_RAM";
+	default:             return "?";
+	}
+}
+
+static int span_is(const char *s, size_t len, const char *word)
+{
+	return strlen(word) == len && memcmp(s, word, len) == 0;
+}
+
+static int parse_retclass(const char *s, size_t len, struct td_call_case *c,
+                          const char **why)
+{
+	static const uint8_t classes[] = { TD_RET_EXACT, TD_RET_IGNORE,
+	                                   TD_RET_NONZERO, TD_RET_HANDLE,
+	                                   TD_RET_PTR_RAM };
+	size_t dot, i;
+
+	trim(&s, &len);
+	for (dot = 0; dot < len && s[dot] != '.'; dot++)
+		;
+	c->retclass = 0xFF;
+	for (i = 0; i < sizeof classes; i++)
+		if (span_is(s, dot, td_retclass_name(classes[i])))
+			c->retclass = classes[i];
+	if (c->retclass == 0xFF) {
+		*why = "retclass is not EXACT, IGNORE, NONZERO, HANDLE or PTR_RAM";
+		return TD_CASE_ERR_RETCLASS;
+	}
+	c->retwidth = TD_RET_WIDTH_LONG;
+	if (dot == len)
+		return 0;
+	/* ".L" is the default and is not spelt: one spelling per meaning, so
+	 * that two tables saying the same thing have the same bytes. */
+	if (span_is(s + dot, len - dot, ".W"))
+		c->retwidth = TD_RET_WIDTH_WORD;
+	else if (span_is(s + dot, len - dot, ".B"))
+		c->retwidth = TD_RET_WIDTH_BYTE;
+	else {
+		*why = "retclass width is not .W or .B (LONG has no suffix)";
+		return TD_CASE_ERR_RETCLASS;
+	}
+	if (c->retclass == TD_RET_IGNORE) {
+		*why = "IGNORE takes no width";
+		return TD_CASE_ERR_RETCLASS;
+	}
+	if (c->retclass == TD_RET_PTR_RAM) {
+		*why = "PTR_RAM takes no width: a pointer is a LONG";
+		return TD_CASE_ERR_RETCLASS;
+	}
+	return 0;
+}
+
+static int parse_call_args(const char *s, size_t len, struct td_call_case *c,
+                           const char **why)
+{
+	size_t i = 0, start = 0;
+
+	c->nargs = 0;
+	trim(&s, &len);
+	if (len == 1 && s[0] == '-')
+		return 0;
+	if (len == 0) {
+		*why = "the args column is empty (\"-\" for none)";
+		return TD_CASE_ERR_VALUE;
+	}
+	for (;;) {
+		if (i == len || s[i] == ',') {
+			const char *a = s + start;
+			size_t alen = i - start;
+			struct td_call_arg *arg;
+			int32_t v;
+			int rc;
+
+			trim(&a, &alen);
+			if (c->nargs >= TD_CALL_ARGS_N) {
+				*why = "more than eight arguments";
+				return TD_CASE_ERR_TOO_MANY_VALUES;
+			}
+			arg = &c->arg[c->nargs];
+			if (alen < 3 || a[1] != ':') {
+				*why = "an argument is not w:<v>, l:<v> or b:<n>";
+				return TD_CASE_ERR_VALUE;
+			}
+			rc = parse_value32(a + 2, alen - 2, &v);
+			if (rc != 0) {
+				*why = "an argument value is not a number";
+				return rc;
+			}
+			switch (a[0]) {
+			case 'w':
+				if (v < -32768 || v > 65535) {
+					*why = "a WORD argument does not fit in 16 bits";
+					return TD_CASE_ERR_RANGE;
+				}
+				arg->kind  = TD_CALL_ARG_WORD;
+				arg->value = (int32_t)(int16_t)(uint16_t)v;
+				break;
+			case 'l':
+				arg->kind  = TD_CALL_ARG_LONG;
+				arg->value = v;
+				break;
+			case 'b':
+				if (v < 0 || v >= TD_CALL_BUF_N) {
+					*why = "a buffer argument names no dumper buffer";
+					return TD_CASE_ERR_RANGE;
+				}
+				arg->kind  = TD_CALL_ARG_BUF;
+				arg->value = v;
+				break;
+			default:
+				*why = "an argument is not w:<v>, l:<v> or b:<n>";
+				return TD_CASE_ERR_VALUE;
+			}
+			c->nargs++;
+			if (i == len)
+				break;
+			start = i + 1;
+		}
+		i++;
+	}
+	return 0;
+}
+
+static int parse_capture(const char *s, size_t len, struct td_call_case *c,
+                         const char **why)
+{
+	size_t colon, end, at;
+	uint32_t idx, length, off = 0;
+	uint8_t unit = 1;
+	int rc;
+
+	c->cap_arg = -1;
+	trim(&s, &len);
+	if (len == 1 && s[0] == '-')
+		return 0;
+	*why = "capture is not - or <argindex>:<length>[.B|.W|.L][@<offset>]";
+	for (colon = 0; colon < len && s[colon] != ':'; colon++)
+		;
+	if (colon == 0 || colon >= len)
+		return TD_CASE_ERR_CAPTURE;
+	for (at = colon; at < len && s[at] != '@'; at++)
+		;
+	for (end = colon; end < at && s[end] != '.'; end++)
+		;
+	if (parse_small(s, colon, 255, &idx) != 0)
+		return TD_CASE_ERR_CAPTURE;
+	rc = parse_small(s + colon + 1, end - colon - 1, 0xFFFF, &length);
+	if (rc != 0)
+		return TD_CASE_ERR_CAPTURE;
+	if (end < at) {
+		if (span_is(s + end, at - end, ".B"))
+			unit = 1;
+		else if (span_is(s + end, at - end, ".W"))
+			unit = 2;
+		else if (span_is(s + end, at - end, ".L"))
+			unit = 4;
+		else {
+			*why = "capture unit is not .B, .W or .L";
+			return TD_CASE_ERR_CAPTURE;
+		}
+	}
+	if (at < len && parse_small(s + at + 1, len - at - 1, 0xFFFF, &off) != 0)
+		return TD_CASE_ERR_CAPTURE;
+
+	if (idx >= c->nargs || c->arg[idx].kind != TD_CALL_ARG_BUF) {
+		*why = "capture names an argument that is not a b: buffer";
+		return TD_CASE_ERR_CAPTURE;
+	}
+	if (length == 0 || length > TD_CALL_CAPTURE_LEN) {
+		*why = "capture length is not 1..256 bytes";
+		return TD_CASE_ERR_CAPTURE;
+	}
+	if (length % unit != 0 || off % unit != 0) {
+		*why = "capture length or offset is not a whole number of units";
+		return TD_CASE_ERR_CAPTURE;
+	}
+	if (off + length > TD_CALL_BUF_BYTES) {
+		*why = "capture runs past the end of the buffer";
+		return TD_CASE_ERR_CAPTURE;
+	}
+	c->cap_arg  = (int8_t)idx;
+	c->cap_unit = unit;
+	c->cap_off  = (uint16_t)off;
+	c->cap_len  = (uint16_t)length;
+	return 0;
+}
+
+/*
+ * THE GUARD (cases.h).  The whitelist: every (trap, function) whose query
+ * arm is established as safe on both machines in tosdump/cases/
+ * COVERAGE-BIOS.md, with the binding's argument widths and the rule its
+ * values have to meet.  Citations per entry are in the ledger; the rule
+ * comments name the arm that makes the call safe.
+ *
+ * Signature letters: 'w' a WORD, 'l' a LONG, 'p' a pointer -- a b: buffer
+ * or an l: value (NULL, or -1 where the call reads -1 as "unchanged").
+ */
+enum {
+	CR_NONE,         /* every value is a query                            */
+	CR_ARG0_M1,      /* arg 0 is -1: the inquiry arm                      */
+	CR_ARG1_M1,      /* arg 1 is -1: Setexc, Setcolor, EsetColor          */
+	CR_ALL_M1,       /* every argument is -1: Kbrate, Keytbl              */
+	CR_SETSCREEN,    /* logLoc, physLoc, rez all -1                       */
+	CR_RSCONF,       /* all -1, or baud -2 (and the rest -1)              */
+	CR_BCONIN,       /* only handles that answer at once on both machines */
+	CR_BCONOUT,      /* CON / raw CON with a printable byte; or no device */
+	CR_CURSCONF,     /* function 5, the blink-rate inquiry                */
+	CR_GIACCESS,     /* a register read: no GIACCESS_WRITE bit            */
+	CR_FLOPRATE,     /* rate -1 or -4: the two inquiries                  */
+	CR_BCONMAP,      /* -1, -2, or a device number that maps nothing      */
+	CR_NVM,          /* read or an invalid op; never write or reset       */
+	CR_BUF0,         /* arg 0 is a dumper buffer: Protobt, Buffptr        */
+	CR_BUF01,        /* args 0 and 1 are dumper buffers: Dsp_Available    */
+	CR_EGETPAL,      /* buffer argument, count fits it as WORDs           */
+	CR_VGETRGB,      /* buffer argument, count fits it as LONGs           */
+	CR_SOUNDCMD,     /* modes 0, 1, 6 with data -1                        */
+	CR_SNDSTATUS     /* reset 0                                           */
+};
