# qemu-virt 1920x1080 16 bpp, real USB path: hover item, leave the box (right), re-enter, leave down, re-enter, leave the bar side (left)
at(14); move(0,-700); move(-1100,0); move(85,0); at(16); shot("file")
move(0,235); at(17.5); shot("item")
move(300,0); at(19); shot("out-right")
move(-230,0); at(20.5); shot("re-enter")
move(0,150); at(22); shot("out-below")
move(0,-100); at(23.5); shot("re-enter2")
move(-300,0); at(25); shot("out-left")
move(150,0); at(26.5); shot("re-enter3")
