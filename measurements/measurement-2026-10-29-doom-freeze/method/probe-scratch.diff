+/// DOOMFREEZE-PROBE (scratch only): hook-byte latency and page-0 clock lag.
+pub mod lat_probe {
+    use core::sync::atomic::{AtomicU32, Ordering};
+    static TS: [AtomicU32; 256] = [const { AtomicU32::new(0) }; 256];
+    static W: AtomicU32 = AtomicU32::new(0);
+    static R: AtomicU32 = AtomicU32::new(0);
+    static MAXLAT: AtomicU32 = AtomicU32::new(0);
+    static MAXLAG: AtomicU32 = AtomicU32::new(0);
+    pub fn queued() {
+        let w = W.fetch_add(1, Ordering::Relaxed);
+        TS[(w % 256) as usize].store(tos_api::bios::tick::hz_200(), Ordering::Relaxed);
+    }
+    pub fn delivered(byte: u8) {
+        let r = R.fetch_add(1, Ordering::Relaxed);
+        let lat = tos_api::bios::tick::hz_200().wrapping_sub(TS[(r % 256) as usize].load(Ordering::Relaxed));
+        let m = MAXLAT.load(Ordering::Relaxed);
+        if lat > m { MAXLAT.store(lat, Ordering::Relaxed); }
+        if lat >= 4 || lat > m || r % 50 == 0 {
+            crate::kprintln!("[lat] byte {:#04x} delivered after {} ticks (max {}) at hz {} q={}", byte, lat, m.max(lat), tos_api::bios::tick::hz_200(), W.load(Ordering::Relaxed).wrapping_sub(r + 1));
+        }
+    }
+    pub fn clock_check() {
+        let Some(p0) = tos_api::bdos::process::current_page0_kva() else { return };
+        // SAFETY: running slot's page 0, static kernel page; 0x4ba + 4 inside.
+        let v = unsafe { (p0.add(0x4BA) as *const u32).read_unaligned() };
+        let lag = tos_api::bios::tick::hz_200().wrapping_sub(v);
+        let m = MAXLAG.load(Ordering::Relaxed);
+        if lag > m { MAXLAG.store(lag, Ordering::Relaxed); }
+        if lag >= 10 && lag < 0x8000_0000 {
+            crate::kprintln!("[clk] page-0 _hz_200 lags by {} ticks at hz {} (max {})", lag, tos_api::bios::tick::hz_200(), m.max(lag));
+        }
+    }
 }
