; PORT12: upstream host/hostfs/C/ASSIGN.SYS with its BX* lines (commercial fonts, gitignored upstream)
; replaced by the eight free fonts of GEMSYS, listed so the font order is fixed on both sides.
PATH = C:\DRIVERS
1P SCREEN.SYS
2P SCREEN.SYS
3P SCREEN.SYS
4P SCREEN.SYS
5P SCREEN.SYS
6P SCREEN.SYS
7P SCREEN.SYS
8P SCREEN.SYS
9P SCREEN.SYS
21 STYLUS.SYS
31 META.SYS
61 MEMORY.SYS
FONTPATH = C:\FONTS
PDFPATH = C:\PRINTS
PDFNAME = PRN
PDFDPI = 600
PAPER = A4
CACHE = 48
HEAP = 192
STACKS = 0
HINTING = ON
PRINTER = PDF
+FONT0648.SPD
+FONT0649.SPD
+FONT0709.SPD
+FONT0710.SPD
+FONT0419.SPD
+FONT0582.SPD
+FONT0583.SPD
+FONT0611.SPD
