+    /// fallback in `track_child`). A child reusing the previous one's slot is
+    /// a new child all the same.
+    pub fn launched(slot: usize) {
+        SEEN_SLOT.store(slot, Ordering::Relaxed);
+        CHILD_INIT.store(false, Ordering::Relaxed);
