+/// Scratch IKBD injector armed on program-identity events (tools/inject-arm.py).
+pub mod inj_arm {
+    use core::sync::atomic::{AtomicBool, AtomicU32, AtomicUsize, Ordering};
+
+    struct Arm {
+        trig: &'static str,
+        /// 0 = desktop up, 1 = launch:NAME, 2 = up:NAME.
+        kind: u8,
+        name: [u8; 8],
+        script: &'static [(u32, u8)],
