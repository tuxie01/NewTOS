+    static STATE: [AtomicU32; 1] = [const { AtomicU32::new(0) }; 1];
+    static T0: [AtomicU32; 1] = [const { AtomicU32::new(0) }; 1];
+    static NEXT: [AtomicUsize; 1] = [const { AtomicUsize::new(0) }; 1];
