+                        }
+                        crate::kprintln!(
+                            "[inj] {} feed {:#04x} at hz_200 {} (+{})",
+                            a.trig,
+                            b,
+                            now,
+                            now.wrapping_sub(t0)
+                        );
+                        crate::ikbd::feed(b);
+                        NEXT[i].store(k + 1, Ordering::Relaxed);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
