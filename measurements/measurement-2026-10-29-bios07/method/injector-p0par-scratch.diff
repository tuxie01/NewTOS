+    static SEEN_SLOT: AtomicUsize = AtomicUsize::new(usize::MAX);
+    static mut SEEN_NAME: [u8; 8] = [b' '; 8];
+    /// `up:` -- the child's `appl_init` seen, its next `evnt_multi` is "up".
+    static CHILD_INIT: AtomicBool = AtomicBool::new(false);
