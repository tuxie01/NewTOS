+    fn event(kind: u8, name: &[u8; 8]) {
+        for (i, a) in ARMS.iter().enumerate() {
+            if a.kind == kind && (kind == 0 || &a.name == name) {
+                let _ = STATE[i].compare_exchange(0, 1, Ordering::AcqRel, Ordering::Relaxed);
+            }
+        }
+    }
